# Copy to .env and fill in. NEVER commit .env.

# --- Database ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=codebase_rag
# Npgsql key/value string or postgres://user:pass@host:5432/db URL. Migrations run on API startup.
DATABASE_URL=Host=postgres;Port=5432;Database=codebase_rag;Username=app;Password=change-me

# --- RAG service (separate repo: codebase-rag-service) ---
# fake = in-memory stand-in, no RAG needed (use until Prism/RAG are ready). http = call RAG_BASE_URL.
RAG_MODE=fake
# Prism mock or real RAG. From inside docker compose use http://host.docker.internal:4010, not localhost.
RAG_BASE_URL=http://host.docker.internal:4010
RAG_API_KEY=change-me
# Timeouts in seconds; final values are chosen from measured p95 (about 2x p95).
RAG_QUERY_TIMEOUT_SECONDS=45
RAG_STATUS_TIMEOUT_SECONDS=5
RAG_REQUEST_TIMEOUT_SECONDS=10
RAG_STATUS_RETRIES=2

# --- Auth ---
# Cookies are Secure by default. Set to false ONLY for plain-http local dev (no TLS).
AUTH_COOKIE_SECURE=false

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ISSUER=codebase-rag-web
JWT_AUDIENCE=codebase-rag-web
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
