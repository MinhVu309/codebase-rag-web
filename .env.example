# Copy to .env and fill in. NEVER commit .env.

# --- Database ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=codebase_rag
# Npgsql key/value string or postgres://user:pass@host:5432/db URL. Migrations run on API startup.
DATABASE_URL=Host=postgres;Port=5432;Database=codebase_rag;Username=app;Password=change-me

# --- RAG service (separate repo: codebase-rag-service) ---
# Point to the Prism mock or the real RAG service
RAG_BASE_URL=http://localhost:4010
RAG_API_KEY=change-me

# --- Auth ---
# Cookies are Secure by default. Set to false ONLY for plain-http local dev (no TLS).
AUTH_COOKIE_SECURE=false

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ISSUER=codebase-rag-web
JWT_AUDIENCE=codebase-rag-web
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
