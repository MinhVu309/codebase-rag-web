# Copy to .env and fill in. NEVER commit .env.

# --- Database ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=codebase_rag
# Npgsql key/value string or postgres://user:pass@host:5432/db URL. Migrations run on API startup.
DATABASE_URL=Host=postgres;Port=5432;Database=codebase_rag;Username=app;Password=change-me

# --- RAG service (separate repo: codebase-rag-service) ---
# fake = in-memory stand-in, no RAG needed (pending -> ready flow, canned answers). http = call RAG_BASE_URL.
RAG_MODE=fake
# With RAG_MODE=http:
#   Prism mock from this compose file (docker compose --profile mock up -d mock-rag): http://mock-rag:4010
#   RAG running on the host machine (not in this compose):                           http://host.docker.internal:<port>
#   Real RAG service: its URL. (Never "localhost" from inside the api container: that is the container itself.)
RAG_BASE_URL=http://mock-rag:4010
# Sent as X-API-Key. Prism only checks that it is present, any non-empty string works; the real RAG checks the value.
RAG_API_KEY=change-me
# Retrieval options sent with every /v1/query (checked at startup; a bad value stops the API).
#   RAG_QUERY_MODE: dense | hybrid. Default hybrid (recommended by the RAG team).
#   RAG_QUERY_RERANK: true | false. Default false. true needs hybrid and adds a lot of latency (loads a cross-encoder).
RAG_QUERY_MODE=hybrid
RAG_QUERY_RERANK=false
# Timeouts in seconds. Query: 65 = max(2x measured p95 of ~25-32s, RAG's LLM_TIMEOUT_MS=60s + 5s), see docs/reports/e2e-local-2026-11-21.md.
# Keep it above RAG's LLM timeout so a slow LLM comes back as RAG's own 504 TIMEOUT, and keep the frontend timeout above it.
RAG_QUERY_TIMEOUT_SECONDS=65
RAG_STATUS_TIMEOUT_SECONDS=5
RAG_REQUEST_TIMEOUT_SECONDS=10
RAG_STATUS_RETRIES=2

# --- Auth ---
# Cookies are Secure by default. Set to false ONLY for plain-http local dev (no TLS).
AUTH_COOKIE_SECURE=false

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ISSUER=codebase-rag-web
JWT_AUDIENCE=codebase-rag-web
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
